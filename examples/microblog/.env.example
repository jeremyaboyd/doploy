# Copy to .env in this directory. Never commit the real file.
#
# doploy reads .env from beside doploy.yml, and the real process environment
# wins over it.

# Name of an SSH key already on your DigitalOcean account.
# List them with: doctl compute ssh-key list
DO_SSH_KEY=my-laptop

# Restrict SSH to your own address. Leave as 0.0.0.0/0 only if you must.
ADMIN_CIDR=0.0.0.0/0

# Postgres role password for the app. Generate something long:
#   openssl rand -base64 32
POSTGRES_PASSWORD=replace-me

# Signs session tokens. Changing it logs everyone out.
#   openssl rand -base64 48
JWT_SECRET=replace-me-too

# Seeded on first deploy. Existing accounts are left alone.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me-as-well
ADMIN_DISPLAY_NAME=Admin

# Largest single upload, in megabytes.
MAX_UPLOAD_MB=256
