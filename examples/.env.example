# Copy to .env beside doploy.yml. Never commit the real thing.
#
# Anything set in the real process environment wins over this file, which is
# what you want in CI.

TAG=latest
LOG_LEVEL=info

DATABASE_URL=postgres://user:password@db.example.com:5432/app

# Only needed if you pull private images.
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_replace_me
